rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 권한 확인 헬퍼 =====

    // 관리자 = superAdmin 역할 또는 operations-office 등급
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberTier == 'operations-office');
    }

    // 승인된 회원 (users 문서가 있으면 승인됨)
    function isApprovedMember() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 나눔회원 이상 (sharing-member, operations-office, superAdmin)
    function isSharingMemberOrAbove() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberTier == 'sharing-member' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberTier == 'operations-office' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin');
    }

    // 권한/상태 필드가 변경되지 않았는지 검증 (본인 자가 업데이트 시 사용)
    function privilegeFieldsUnchanged() {
      let existing = resource.data;
      let incoming = request.resource.data;
      return incoming.role == existing.role &&
             incoming.memberTier == existing.memberTier &&
             incoming.status == existing.status;
    }

    // 교단일기 좋아요 토글 전용: likes 필드(+updatedAt)만 변경 허용
    function onlyDiaryLikesChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likes', 'updatedAt']);
    }

    // 나눔활동 신청 카운터 전용: appliedCount(+updatedAt)만 변경 허용
    function onlyAppliedCountChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['appliedCount', 'updatedAt']);
    }

    // ===== FCM 토큰: 본인 소유 토큰만 조작 =====
    match /fcm_tokens/{tokenId} {
      // 생성/수정: 인증된 사용자이되, 문서의 uid 필드가 본인 uid여야 함
      //   → 남의 토큰 문서를 위조/탈취 방지. 과거 문서에 uid 필드가 없어도
      //     이 rule을 통과하려면 본인 uid를 추가해야 함(fcm-client.js가 자동 처리)
      allow create, update: if request.auth != null &&
                               request.resource.data.uid == request.auth.uid;

      // 읽기: 인증된 사용자 (개인 구독 설정 조회 시 필요)
      allow read: if request.auth != null;

      // 삭제: 관리자 또는 본인 소유 토큰
      allow delete: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.uid == request.auth.uid);
    }

    // ===== 대외행사: 관리자(운영사무국/최고관리자)만 작성/수정/삭제 =====
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== 월별연수: 사용 중지 → 관리자만 쓰기 가능 (정리/복구용) =====
    match /trainings/{trainingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== 자료공유: 배움회원 이상 본인 자료 관리, 관리자는 전체 관리 =====
    match /resources/{resourceId} {
      allow read: if true;

      // 생성: 승인된 회원(배움회원 이상), createdBy는 반드시 본인 uid
      allow create: if isApprovedMember() &&
                       request.resource.data.createdBy == request.auth.uid;

      // 수정/삭제: 본인 작성본 OR 관리자
      allow update, delete: if isAdmin() ||
                               (isApprovedMember() &&
                                resource.data.createdBy == request.auth.uid);
    }

    // ===== 교단일기: 누구나 작성, 본인만 수정, 관리자도 삭제 가능 =====
    match /diaries/{diaryId} {
      allow read: if true;

      // 생성: 승인된 회원 누구나, authorId는 반드시 본인 uid
      allow create: if isApprovedMember() &&
                       request.resource.data.authorId == request.auth.uid;

      // 수정: 본인 전체 / 관리자 전체 / 남의 일기라도 좋아요(likes) 토글은 허용
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.authorId == request.auth.uid) ||
                       (isApprovedMember() && onlyDiaryLikesChanged());

      // 삭제: 본인 또는 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.authorId == request.auth.uid);
    }

    // ===== 사용자 컬렉션 - 권한 상승 공격 방어 =====
    match /users/{userId} {
      // 읽기: 인증된 사용자 (회원 목록 조회 등)
      allow read: if request.auth != null;

      // 생성: 관리자만 (가입 승인 시 관리자 패널에서 생성)
      //   → 일반 사용자는 이 컬렉션에 직접 문서를 만들 수 없음. 회원가입은 pendingUsers를 통해서만.
      allow create: if isAdmin();

      // 수정: 관리자 전체 OR 본인이되 권한 관련 필드는 변경 불가
      //   → role/memberTier/status 자가 변경 차단 (권한 상승 방지)
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        request.auth.uid == userId &&
                        privilegeFieldsUnchanged());

      // 삭제: 관리자만 (Cloud Function deleteUser는 Admin SDK로 rules 우회)
      allow delete: if isAdmin();
    }

    // ===== 가입 대기 사용자 컬렉션 - 조작 방지 =====
    match /pendingUsers/{pendingId} {
      // 읽기: 본인 또는 관리자
      allow read: if request.auth != null &&
                     (request.auth.uid == pendingId || isAdmin());

      // 생성: 본인만 (회원가입 절차 - docId가 본인 uid여야 함)
      allow create: if request.auth != null && request.auth.uid == pendingId;

      // 수정/삭제: 관리자만 (승인/거부 시 관리자 패널에서 삭제)
      allow update, delete: if isAdmin();
    }

    // 방문자 통계 컬렉션 - 누구나 읽기/쓰기 가능 (익명 방문자 포함)
    match /visitorStats/{docId} {
      allow read, write: if true;
    }

    // ===== 나눔활동: 나눔회원+ 본인 활동 관리, 관리자는 전체 관리 =====
    //   (신청 시 다른 사람의 appliedCount 갱신 허용)
    match /sharingActivities/{activityId} {
      allow read: if true;

      // 생성: 나눔회원 이상, creatorUid는 반드시 본인 uid
      allow create: if isSharingMemberOrAbove() &&
                       request.resource.data.creatorUid == request.auth.uid;

      // 수정: 본인 전체 / 관리자 전체 / 남의 활동이라도 appliedCount만 변경 허용
      //   (상태 변경 "종료"/"재개"도 본인/관리자의 일반 업데이트로 처리됨)
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.creatorUid == request.auth.uid) ||
                       (isApprovedMember() && onlyAppliedCountChanged());

      // 삭제: 본인 또는 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.creatorUid == request.auth.uid);
    }

    // ===== 나눔활동 신청: 본인 신청만 생성/수정/삭제 (관리자는 전체) =====
    match /sharingApplications/{applicationId} {
      // 읽기: 공개 유지 (활동 개설자가 신청자 목록 조회 필요)
      allow read: if true;

      // 생성: 승인된 회원, applicantUid는 반드시 본인 uid
      //   → 남의 명의로 신청 위조 방지
      allow create: if isApprovedMember() &&
                       request.resource.data.applicantUid == request.auth.uid;

      // 수정: 본인 신청 OR 관리자 (본인이되 applicantUid 바꿀 수 없음)
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.applicantUid == request.auth.uid &&
                        request.resource.data.applicantUid == request.auth.uid);

      // 삭제: 본인 신청 OR 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.applicantUid == request.auth.uid);
    }
  }
}
