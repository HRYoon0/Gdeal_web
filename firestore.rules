rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 권한 확인 헬퍼 =====

    // 관리자 = superAdmin 역할 또는 operations-office 등급
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberTier == 'operations-office');
    }

    // 승인된 회원 (users 문서가 있으면 승인됨)
    function isApprovedMember() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 나눔회원 이상 (sharing-member, operations-office, superAdmin)
    function isSharingMemberOrAbove() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberTier == 'sharing-member' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberTier == 'operations-office' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin');
    }

    // ===== 나눔활동 신청 대상 등급 =====
    //   sharingActivities.minTier: '' | 'learning-member' | 'sharing-member' | 'operations-office'
    //   필드가 없거나 빈 값이면 제한 없음. 화면(sharing.js·홈 카드·성장패스)과 같은 서열.
    function tierRank(tier) {
      return tier == 'operations-office' ? 3 :
             (tier == 'sharing-member' ? 2 :
             (tier == 'learning-member' ? 1 : 0));
    }

    function myTierRank() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('role', '') == 'superAdmin' ? 3 : tierRank(u.get('memberTier', ''));
    }

    // 신청 자격: 대상 미지정 OR 개설자 본인 OR 운영진 OR 내 등급이 대상 등급 이상
    function meetsActivityTier(activityId) {
      let a = get(/databases/$(database)/documents/sharingActivities/$(activityId)).data;
      return a.get('minTier', '') == '' ||
             a.get('creatorUid', '') == request.auth.uid ||
             isAdmin() ||
             myTierRank() >= tierRank(a.get('minTier', ''));
    }

    // 권한/상태 필드가 변경되지 않았는지 검증 (본인 자가 업데이트 시 사용)
    function privilegeFieldsUnchanged() {
      let existing = resource.data;
      let incoming = request.resource.data;
      // .get(키, 기본값): 옛 회원 문서에 role 등이 없어도 비교가 오류로 거부되지 않게
      return incoming.get('role', null) == existing.get('role', null) &&
             incoming.get('memberTier', null) == existing.get('memberTier', null) &&
             incoming.get('status', null) == existing.get('status', null);
    }

    // 교단일기 좋아요 토글 전용: likes 필드(+updatedAt)만 변경 허용
    function onlyDiaryLikesChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likes', 'updatedAt']);
    }

    // 나눔활동 신청 카운터 전용: appliedCount(+updatedAt)만 변경 허용
    function onlyAppliedCountChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['appliedCount', 'updatedAt']);
    }

    // ===== FCM 토큰: 본인 소유 토큰만 조작 =====
    match /fcm_tokens/{tokenId} {
      // 생성/수정: 인증된 사용자이되, 문서의 uid 필드가 본인 uid여야 함
      //   → 남의 토큰 문서를 위조/탈취 방지. 과거 문서에 uid 필드가 없어도
      //     이 rule을 통과하려면 본인 uid를 추가해야 함(fcm-client.js가 자동 처리)
      allow create, update: if request.auth != null &&
                               request.resource.data.uid == request.auth.uid;

      // 읽기: 인증된 사용자 (개인 구독 설정 조회 시 필요)
      allow read: if request.auth != null;

      // 삭제: 관리자 또는 본인 소유 토큰
      allow delete: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.uid == request.auth.uid);
    }

    // ===== 대외행사: 관리자(운영사무국/최고관리자)만 작성/수정/삭제 =====
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== 월별연수: 사용 중지 → 관리자만 쓰기 가능 (정리/복구용) =====
    match /trainings/{trainingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== 자료공유: 배움회원 이상 본인 자료 관리, 관리자는 전체 관리 =====
    //   (웹앱 광장 통합: 추천 featured는 관리자만, 사용 수 usedCount는 '사용해 봤어요' 배치로만 +1)
    match /resources/{resourceId} {
      allow read: if true;

      // 생성: 승인된 회원(배움회원 이상), createdBy는 반드시 본인 uid, 추천·사용 수 위조 불가
      allow create: if isApprovedMember() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.get('featured', false) == false &&
                       request.resource.data.get('usedCount', 0) == 0;

      // 수정: 관리자 전체 / 본인 자료는 createdBy·featured·usedCount 제외 / 누구나 '사용해 봤어요'로 +1
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.createdBy == request.auth.uid &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['createdBy', 'featured', 'usedCount'])) ||
                       (isApprovedMember() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
                        request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1 &&
                        !exists(/databases/$(database)/documents/resources/$(resourceId)/uses/$(request.auth.uid)) &&
                        existsAfter(/databases/$(database)/documents/resources/$(resourceId)/uses/$(request.auth.uid)));

      // 삭제: 본인 작성본 OR 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.createdBy == request.auth.uid);

      match /uses/{uid} {
        allow read: if true;
        allow create: if isApprovedMember() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }

      // 구조화된 활용 후기 (자료당 회원 1건)
      match /reviews/{uid} {
        allow read: if isApprovedMember();
        allow create, update: if isApprovedMember() &&
                                 request.auth.uid == uid &&
                                 request.resource.data.uid == uid;
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }
    }

    // ===== 교단일기: 누구나 작성, 본인만 수정, 관리자도 삭제 가능 =====
    match /diaries/{diaryId} {
      allow read: if true;

      // 생성: 승인된 회원 누구나, authorId는 반드시 본인 uid
      allow create: if isApprovedMember() &&
                       request.resource.data.authorId == request.auth.uid;

      // 수정: 본인 전체 / 관리자 전체 / 남의 일기라도 좋아요(likes) 토글은 허용
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.authorId == request.auth.uid) ||
                       (isApprovedMember() && onlyDiaryLikesChanged());

      // 삭제: 본인 또는 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.authorId == request.auth.uid);
    }

    // ===== 사용자 컬렉션 - 권한 상승 공격 방어 =====
    match /users/{userId} {
      // 읽기: 인증된 사용자 (회원 목록 조회 등)
      allow read: if request.auth != null;

      // 생성: 관리자만 (가입 승인 시 관리자 패널에서 생성)
      //   → 일반 사용자는 이 컬렉션에 직접 문서를 만들 수 없음. 회원가입은 pendingUsers를 통해서만.
      allow create: if isAdmin();

      // 수정: 관리자 전체 OR 본인이되 권한 관련 필드는 변경 불가
      //   → role/memberTier/status 자가 변경 차단 (권한 상승 방지)
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        request.auth.uid == userId &&
                        privilegeFieldsUnchanged());

      // 삭제: 관리자만 (Cloud Function deleteUser는 Admin SDK로 rules 우회)
      allow delete: if isAdmin();
    }

    // ===== 가입 대기 사용자 컬렉션 - 조작 방지 =====
    match /pendingUsers/{pendingId} {
      // 읽기: 본인 또는 관리자
      allow read: if request.auth != null &&
                     (request.auth.uid == pendingId || isAdmin());

      // 생성: 본인만 (회원가입 절차 - docId가 본인 uid여야 함)
      allow create: if request.auth != null && request.auth.uid == pendingId;

      // 수정/삭제: 관리자만 (승인/거부 시 관리자 패널에서 삭제)
      allow update, delete: if isAdmin();
    }

    // 방문자 통계 컬렉션 - 누구나 읽기/쓰기 가능 (익명 방문자 포함)
    match /visitorStats/{docId} {
      allow read, write: if true;
    }

    // ===== 나눔활동: 나눔회원+ 본인 활동 관리, 관리자는 전체 관리 =====
    //   (신청 시 다른 사람의 appliedCount 갱신 허용)
    match /sharingActivities/{activityId} {
      allow read: if true;

      // 생성: 나눔회원 이상, creatorUid는 반드시 본인 uid
      allow create: if isSharingMemberOrAbove() &&
                       request.resource.data.creatorUid == request.auth.uid;

      // 수정: 본인 전체 / 관리자 전체 / 남의 활동이라도 appliedCount만 변경 허용
      //   (상태 변경 "종료"/"재개"도 본인/관리자의 일반 업데이트로 처리됨)
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.creatorUid == request.auth.uid) ||
                       (isApprovedMember() && onlyAppliedCountChanged());

      // 삭제: 본인 또는 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.creatorUid == request.auth.uid);
    }

    // ================= 성장패스 (활동 기록 원장 · 웨비나 인증 · 배지 · 웹앱 광장 · 포트폴리오) =================

    // 회원이 직접 남기는 원장 기록 검증
    //   - 성찰/실천: 바로 인정(auto)
    //   - 발표·진행/소모임 프로젝트: 운영진 확인 대기(pending)
    //   - 참여 인증(웨비나·카페연수 등 나눔활동): 문서 ID가 {uid}_attend_{대상ID}(중복 방지)이고, 인증 코드가 비공개 코드와 일치할 때만
    //   - 피드백(자료 후기): 문서 ID가 {uid}_feedback_{자료ID}(자료당 1회)
    function validSelfLog(logId) {
      let d = request.resource.data;
      return isApprovedMember() &&
             d.uid == request.auth.uid &&
             d.visibility in ['private', 'group', 'public'] &&
             (
               (d.type in ['reflection', 'practice'] && d.status == 'auto') ||
               (d.type in ['webinar_host', 'group_project'] && d.status == 'pending') ||
               (d.type in ['webinar_attend', 'sharing_attend', 'event_attend'] && d.status == 'auto' &&
                  logId == request.auth.uid + '_attend_' + d.targetId &&
                  get(/databases/$(database)/documents/webinarSecrets/$(d.targetId)).data.open == true &&
                  get(/databases/$(database)/documents/webinarSecrets/$(d.targetId)).data.code == d.checkinCode) ||
               (d.type == 'feedback' && d.status == 'auto' &&
                  logId == request.auth.uid + '_feedback_' + d.targetId &&
                  exists(/databases/$(database)/documents/resources/$(d.targetId)))
             );
    }

    // 웨비나: 공개 읽기, 관리자만 쓰기
    match /webinars/{webinarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 나눔활동 개설자인지 (영역과 관계없이 자기 나눔활동의 인증 코드를 개설자가 직접 관리)
    function isSharingCreator(activityId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/sharingActivities/$(activityId)) &&
             get(/databases/$(database)/documents/sharingActivities/$(activityId)).data.creatorUid == request.auth.uid;
    }

    // 웨비나 인증 코드: 관리자 또는 해당 나눔활동 개설자만 읽고 씀. 회원 인증은 위 validSelfLog의 get()으로만 대조한다.
    match /webinarSecrets/{webinarId} {
      allow read, write: if isAdmin() || isSharingCreator(webinarId);
    }

    // 활동 기록 원장
    match /activityLog/{logId} {
      // resource == null: 없는 문서 조회 허용(웨비나 중복 인증 여부 확인용). 존재 여부 외 정보는 드러나지 않는다.
      allow read: if resource == null || isAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid) ||
                     (isApprovedMember() && resource.data.visibility == 'public') ||
                     // 나눔활동 개설자: 자기 활동의 참여 인증 기록만(성찰 내용은 제외). 조회는 targetId·type을 == 조건으로 걸어야 허용된다.
                     (isApprovedMember() && resource.data.type in ['webinar_attend', 'sharing_attend'] &&
                      get(/databases/$(database)/documents/sharingActivities/$(resource.data.targetId)).data.creatorUid == request.auth.uid) ||
                     // 소모임 공유: 그 소모임 구성원만. 조회는 groupId·visibility를 == 조건으로 걸어야 허용된다.
                     (isApprovedMember() && resource.data.visibility == 'group' &&
                      request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids);

      allow create: if isAdmin() || validSelfLog(logId);

      // 본인은 내용·공개 범위만 수정 가능 (유형·상태·대상·소유자는 고정)
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.uid == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['answers', 'visibility', 'evidence', 'groupId', 'updatedAt']) &&
                        request.resource.data.visibility in ['private', 'group', 'public']);

      allow delete: if isAdmin() ||
                       (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // 배지 규칙: 공개 읽기(회원 화면에서 계산), 관리자만 설정
    match /badgeRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 수동 배지 지급 기록
    match /badgeGrants/{grantId} {
      allow read: if isAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // 성장패스 점수판: Cloud Function(Admin SDK)만 쓴다. public(이름 없음)은 누구나, members(이름 포함)는 로그인한 사용자만
    match /leaderboard/{docId} {
      allow read: if docId == 'public' || request.auth != null;
      allow write: if false;
    }

    // 소모임
    match /groups/{groupId} {
      allow read: if isApprovedMember();
      allow write: if isAdmin();
    }

    // 포트폴리오: 저장 시점의 기록을 복사해 둔 스냅샷. 링크 공유(shareMode='link')면 누구나 읽기.
    match /portfolios/{portfolioId} {
      allow read: if resource.data.shareMode == 'link' || isAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() ||
                       (isApprovedMember() &&
                        request.resource.data.uid == request.auth.uid &&
                        request.resource.data.kind == 'personal');

      allow update: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.uid == request.auth.uid &&
                        request.resource.data.uid == request.auth.uid &&
                        request.resource.data.kind == 'personal');

      allow delete: if isAdmin() ||
                       (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // ===== 나눔활동 신청: 본인 신청만 생성/수정/삭제 (관리자는 전체) =====
    match /sharingApplications/{applicationId} {
      // 읽기: 공개 유지 (활동 개설자가 신청자 목록 조회 필요)
      allow read: if true;

      // 생성: 승인된 회원, applicantUid는 반드시 본인 uid, 그리고 활동의 신청 대상 등급을 충족
      //   → 남의 명의로 신청 위조 방지 + 화면에서 숨긴 활동을 직접 호출로 신청하는 것 방지
      allow create: if isApprovedMember() &&
                       request.resource.data.applicantUid == request.auth.uid &&
                       meetsActivityTier(request.resource.data.activityId);

      // 수정: 본인 신청 OR 관리자 (본인이되 applicantUid 바꿀 수 없음)
      allow update: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.applicantUid == request.auth.uid &&
                        request.resource.data.applicantUid == request.auth.uid);

      // 삭제: 본인 신청 OR 관리자
      allow delete: if isAdmin() ||
                       (isApprovedMember() &&
                        resource.data.applicantUid == request.auth.uid);
    }
  }
}
