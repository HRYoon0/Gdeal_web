{
  "hosting": {
    "site": "gdeal-page-a67e2",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!.well-known",
      "**/node_modules/**",
      "functions/**",
      "**/*.check.js"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/apps",
        "destination": "/resources/",
        "type": 301
      },
      {
        "source": "/apps/**",
        "destination": "/resources/",
        "type": 301
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["cp \"$PROJECT_DIR/growth/rules.js\" \"$RESOURCE_DIR/growth-rules.js\""]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
